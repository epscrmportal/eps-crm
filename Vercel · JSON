{
  "version": 2,
  "buildCommand": "echo 'Static HTML - no build needed'",
  "outputDirectory": ".",
  "public": false,
  "routes": [
    {
      "src": "/",
      "dest": "/eps-crm-cloud.html",
      "methods": ["GET", "HEAD"]
    },
    {
      "src": "/(.*)",
      "dest": "/eps-crm-cloud.html",
      "methods": ["GET", "HEAD"]
    }
  ]
}
